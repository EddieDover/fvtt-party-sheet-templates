{
  "name": "Cypher System 2",
  "system": "cypherv2",
  "author": "peaeater",
  "version": "2.0.0",
  "minimumSystemVersion": "0.1.0",
  "offline_excludes_property": "type",
  "offline_excludes": [
    "npc"
  ],
  "rows": [
    [
      {
        "name": "Character Sheet",
        "type": "charactersheet",
        "header": "hide",
        "text": "",
        "minwidth": 40,
        "maxwidth": 40
      },
      {
        "name": "Character",
        "type": "direct-complex",
        "header": "show",
        "text": [
          {
            "type": "exists",
            "value": "system.derived.packages.characterSentence",
            "text": "{b}{name}{/b}{nl}{i}{system.derived.packages.characterSentence}{/i}",
            "else": "{b}{name}{/b}{nl}{i}{system.derived.packages.speciesNames}{s}{system.derived.packages.typeNames}{/i}"
          }
        ]
      },
      {
        "name": "Might",
        "type": "direct",
        "header": "show",
        "align": "center",
        "text": "{system.stats.might.value}{s2}/{s2}{system.stats.might.max}{nl}{i}Edge {system.stats.might.edge}{/i}{nl}{progress {system.stats.might.value} {system.stats.might.max} #71927B}"
      },
      {
        "name": "Speed",
        "type": "direct",
        "header": "show",
        "align": "center",
        "text": "{system.stats.speed.value}{s2}/{s2}{system.stats.speed.max}{nl}{i}Edge {system.stats.speed.edge}{/i}{nl}{progress {system.stats.speed.value} {system.stats.speed.max} #71927B}"
      },
      {
        "name": "Intellect",
        "type": "direct",
        "header": "show",
        "align": "center",
        "text": "{system.stats.intellect.value}{s2}/{s2}{system.stats.intellect.max}{nl}{i}Edge {system.stats.intellect.edge}{/i}{nl}{progress {system.stats.intellect.value} {system.stats.intellect.max} #71927B}"
      },
      {
        "name": "Wounds",
        "type": "direct-complex",
        "header": "show",
        "text": [
          {
            "type": "exists",
            "value": "system.derived.wounds.capacities.minor",
            "text": "{i}MIN{/i} {system.wounds.minor.length} / {system.derived.wounds.capacities.minor} · {i}MOD{/i} {system.wounds.moderate.length} / {system.derived.wounds.capacities.moderate} · {i}MAJ{/i} {system.wounds.major.length} / {system.derived.wounds.capacities.major}{nl}"
          },
          {
            "type": "exists",
            "value": "system.derived.wounds.dead",
            "text": "{c:#D85B66}{b}DEAD{/b}{/c}{nl}"
          },
          {
            "type": "match",
            "ifdata": "system.derived.wounds.hindrance",
            "matches": 0,
            "text": "",
            "else": "{c:#E1747D}{b}Hindered {system.derived.wounds.hindrance} step{/b}{/c}"
          }
        ]
      },
      {
        "name": "Defense",
        "type": "direct-complex",
        "header": "show",
        "text": [
          {
            "type": "match",
            "ifdata": "system.derived.combat.armor.category",
            "matches": "none",
            "text": "{i}No armor{/i}",
            "else": "{system.derived.combat.armor.category}"
          },
          {
            "type": "match",
            "ifdata": "system.derived.combat.armor.blockEase",
            "matches": 0,
            "text": "",
            "else": "{nl}{i}Block +{system.derived.combat.armor.blockEase}{/i}"
          },
          {
            "type": "match",
            "ifdata": "system.derived.combat.armor.dodgeHindrance",
            "matches": 0,
            "text": "",
            "else": "{nl}{i}Dodge {system.derived.combat.armor.dodgeHindrance}{/i}"
          },
          {
            "type": "match",
            "ifdata": "system.derived.combat.armor.speedTaskHindrance",
            "matches": 0,
            "text": "",
            "else": "{nl}{i}Speed {system.derived.combat.armor.speedTaskHindrance}{/i}"
          }
        ]
      },
      {
        "name": "Recovery",
        "type": "direct-complex",
        "header": "show",
        "text": [
          {
            "type": "match",
            "ifdata": "system.derived.recovery.availableTypes.length",
            "matches": 0,
            "text": "{system.derived.recovery.formula}{nl}{c:#D85B66}{b}none left{/b}{/c}",
            "else": "{system.derived.recovery.formula}{nl}{i}{system.derived.recovery.availableTypes.length} of {system.recovery.slots.length} available{/i}"
          }
        ]
      },
      {
        "name": "Skills",
        "type": "object-loop",
        "header": "show",
        "text": "{dropdown} [Trained+] _source.items{type == 'skill' && system.rank != 'untrained' && system.rank != 'inability'} =><div class=\"zin-skill-entry\">{b}{name}{/b} {i}({system.rank}){/i}</div>||[Untrained] _source.items{type == 'skill' && system.rank == 'untrained'} =><div class=\"zin-skill-entry\">{name} {i}({system.rank}){/i}</div>||[Inabilities] _source.items{type == 'skill' && system.rank == 'inability'} =><div class=\"zin-skill-entry\">{c:#D85B66}{name} ({system.rank}){/c}</div>"
      },
      {
        "name": "Cyphers",
        "type": "object-loop",
        "header": "show",
        "text": "_source.items{cypher} =>{name}{nl}"
      },
      {
        "name": "Cypher Max",
        "type": "direct",
        "header": "show",
        "text": "{system.derived.cypherLimit.max}"
      },
      {
        "name": "Weapons",
        "type": "object-loop",
        "header": "show",
        "text": "_source.items{weapon} =>{name} ({system.category}){nl}"
      },
      {
        "name": "XP / RP",
        "type": "direct",
        "header": "show",
        "align": "center",
        "text": "{system.xp}{s2}/{s2}{system.resourcePoints}{nl}{i}Tier {system.tier} · Effort {system.derived.effort.max}{/i}"
      }
    ]
  ]
}
